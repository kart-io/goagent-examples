# 复制为 .env 后填写；.env 已被仓库根 .gitignore 忽略，不要提交。
# shell 中已导出的同名变量优先于 .env。

# 缓存标签 HMAC 密钥：至少 32 字节的 hex，多实例必须相同。生成：openssl rand -hex 32
KA_CACHE_TAG_KEY=

# 嵌入：gemini（默认，需 GEMINI_API_KEY）或 hash（离线确定性嵌入，仅用于演练）
KA_EMBEDDER=gemini
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 对话模型：live（默认）或 script（离线脚本模型，仅用于演练）
KA_MODEL=live
# live 模式的提供方：deepseek（默认）| minimax | gemini，只需填所选提供方的 key
GOAGENT_LIVE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# 覆盖默认模型名：DEEPSEEK_MODEL / MINIMAX_MODEL / GEMINI_MODEL

# 宿主机端口，默认 8081/8082，被占用时改这里
# KA_A_PORT=8081
# KA_B_PORT=8082

# ingest 时 Gemini 嵌入的并发上限，默认 8，范围 1..64；被限流时调小
# KA_EMBED_PARALLEL=8
